{
    "name": "austintoddj/canvas",
    "description": "A Laravel publishing platform",
    "keywords": [
        "blog",
        "canvas",
        "laravel",
        "publishing",
        "platform"
    ],
    "license": "MIT",
    "homepage": "https://trycanvas.app",
    "support": {
        "issues": "https://github.com/austintoddj/canvas/issues",
        "source": "https://github.com/austintoddj/canvas"
    },
    "authors": [
        {
            "name": "Todd Austin",
            "email": "austin.todd.j@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/pagination": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/translation": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.8|^11.0",
        "pestphp/pest": "^3.8|^4.0",
        "pestphp/pest-plugin-arch": "^3.8|^4.0",
        "pestphp/pest-plugin-laravel": "^3.2|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Canvas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Canvas\\Database\\Factories\\": "database/factories/",
            "Canvas\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "@build",
            "@php vendor/bin/testbench serve"
        ],
        "lint": [
            "@php vendor/bin/phpstan analyse"
        ],
        "test": [
            "@php vendor/bin/pest"
        ],
        "test:parallel": "vendor/bin/pest --parallel",
        "test:ci": "mkdir -p build && vendor/bin/pest --parallel --compact --log-junit=build/junit.xml",
        "test:coverage": "php -d memory_limit=1G vendor/bin/pest --coverage --min=98",
        "test:coverage:html": "php -d memory_limit=1G vendor/bin/pest --coverage-html=build/coverage --coverage-clover=build/coverage/clover.xml --min=98",
        "test:database": "vendor/bin/pest --group=database --compact",
        "test:install-smoke": "bash bin/install-smoke.sh",
        "pint": "pint",
        "pint:test": "pint --test",
        "pint:fix": "pint",
        "preflight": "bash bin/preflight.sh"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Canvas\\CanvasServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
